# Copy to .env and fill in to customise `docker compose up`.

# Post alerts to Slack or Discord (leave empty to only log + show in the dashboard)
# WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# WEBHOOK_URL=https://discord.com/api/webhooks/123/abc
WEBHOOK_URL=

# Detection tuning
WINDOW_S=30
TRIP_COUNT=3
CLEAR_COUNT=4
STALE_AFTER_S=30

# Simulator
SIM_INTERVAL_S=5
SIM_INCIDENT_RATE=0.0004
